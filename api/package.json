{
  "name": "api",
  "version": "1.0.0",
  "description": "Backend REST API for BookRead.",
  "homepage": "https://github.com/goncalopereira13k/BookRead/tree/main/api#readme",
  "bugs": {
    "url": "https://github.com/goncalopereira13k/BookRead/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goncalopereira13k/BookRead.git",
    "directory": "api"
  },
  "license": "MIT",
  "author": "Gonçalo Pereira, Diogo Correia",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "test": "cross-env NODE_ENV=test jest --detectOpenHandles --forceExit --runInBand",
    "start": "node server.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^148.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.14.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "sequelize-mock": "^0.10.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "sqlite3": "^5.1.7",
    "supertest": "^7.1.0"
  },
  "overrides": {
    "eslint": "^9",
    "glob": "^10"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "<rootDir>/tests/jest.setup.js"
    ],
    "testEnvironment": "node",
    "testTimeout": 5000,
    "detectOpenHandles": true,
    "forceExit": true,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/models/index.js"
    ]
  }
}
